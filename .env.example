# Copie para .env (ignorado pelo Git) e troque os valores. Todos abaixo são fictícios.
# A senha entra na DATABASE_URL: use apenas letras, dígitos, "-", "_" e ".".
POSTGRES_USER=finbank_v2
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finbank_v2

# Usuário de execução da API (DEV-012), criado ou atualizado pelo serviço de migração.
# Nome: 3 a 63 caracteres a-z, 0-9 ou "_", diferente de POSTGRES_USER.
# Senha: 16 a 128 caracteres A-Z, a-z, 0-9, ".", "-" ou "_".
RUNTIME_DB_USER=finbank_app
RUNTIME_DB_PASSWORD=troque-esta-senha-de-execucao

# Portas do host (sempre ligadas a 127.0.0.1). Opcionais.
POSTGRES_HOST_PORT=15432
API_HOST_PORT=13000
WEB_HOST_PORT=18080
