# Copie para .env (ignorado pelo Git) e troque os valores. Todos abaixo são fictícios.
# A senha entra na DATABASE_URL: use apenas letras, dígitos, "-", "_" e ".".
POSTGRES_USER=finbank_v2
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finbank_v2

# Portas do host (sempre ligadas a 127.0.0.1). Opcionais.
POSTGRES_HOST_PORT=15432
API_HOST_PORT=13000
WEB_HOST_PORT=18080
